{
  "expo": {
    "name": "Habito",
    "slug": "habito",
    "version": "1.0.0",
    "scheme": "habito",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#111111",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.habito.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.habito.app",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#111111"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#72d7f0",
          "defaultChannel": "reminders",
          "sounds": [
            "./assets/sounds/chime.wav",
            "./assets/sounds/bloom.wav",
            "./assets/sounds/drop.wav",
            "./assets/sounds/pulse.wav"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "03cf6145-1d8c-4a6d-b2ea-5a4eb19793f3"
      }
    },
    "owner": "devsnio",
    "updates": {
      "url": "https://u.expo.dev/03cf6145-1d8c-4a6d-b2ea-5a4eb19793f3"
    }
  }
}
