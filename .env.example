# RevenueCat public SDK keys (Project settings → API keys). Leave unset to run
# the paywall in preview mode, where debug builds unlock Pro without a charge.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Optional: shown as "Privacy" on the paywall. Required by both stores for subscriptions.
EXPO_PUBLIC_PRIVACY_URL=
